    {
      "name": "Verify + normalize",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        420,
        300
      ],
      "parameters": {
        "jsCode": "// Inbound SMS from Twilio (form-encoded). Fail closed on bad signature\n// so nobody can inject rows with plain POSTs.\nconst crypto = require('crypto');\nconst AUTH_TOKEN = 'REPLACE_WITH_TWILIO_AUTH_TOKEN';\nconst WEBHOOK_URL = 'https://n8n.andresgomez.store/webhook/receptionist-sms';\nconst b = $input.first().json;\nconst p = b.body ?? b;\nconst headers = b.headers ?? {};\nconst sig = headers['x-twilio-signature'] || '';\nconst keys = Object.keys(p).filter((k) => typeof p[k] !== 'object').sort();\nlet data = WEBHOOK_URL;\nfor (const k of keys) data += k + (p[k] ?? '');\nconst expected = crypto.createHmac('sha1', AUTH_TOKEN).update(data).digest('base64');\nif (!sig || sig !== expected) throw new Error('invalid Twilio signature');\nreturn [{ json: {\n  sender: p.From ?? '',\n  text: p.Body ?? '',\n  to_number: p.To ?? '',\n  message_sid: p.MessageSid ?? '',\n  timestamp: new Date().toISOString(),\n}}];"
      },
      "id": "60e60c35-e85b-42e9-bd45-3461c42ab556"
    },
