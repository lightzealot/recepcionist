    {
      "id": "0e302e6a-fa72-40ea-9ab2-98094fb4f664",
      "name": "Split segments",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        420,
        300
      ],
      "parameters": {
        "jsCode": "// Split a transcript backup into one item per segment.\n// Input: { transcript: { metadata: {...}, segments: [...] } }\n// (webhook wraps the POSTed JSON in `body`.)\nconst b = $input.first().json;\nconst p = b.body ?? b;\nconst t = p.transcript || {};\nconst m = t.metadata || {};\nconst label = { user: \"Caller\", assistant: \"Agent\", tool: \"Tool\" };\nreturn (t.segments || []).map((s) => ({ json: {\n  call_id: m.call_id ?? \"\",\n  timestamp: s.created_at ? new Date(s.created_at > 1e12 ? s.created_at : s.created_at * 1000).toISOString() : \"\",\n  role: label[s.role] ?? (s.role ?? \"\"),\n  text: s.text ?? \"\",\n  caller_phone: m.caller_phone ?? \"\",\n  business: m.business_name ?? \"\",\n}}));"
      }
    },
